   "source": [
    "def bubble(nums):\n",
    "    n = len(nums)\n",
    "    for passes in range(n) :\n",
    "        for j in range(n-passes-1):\n",
    "            if nums[j]>nums[j+1]:\n",
    "                nums[j],nums[j+1]= nums[j+1],nums[j]\n",
    "    return nums\n",
    "\n",
    "nums = [1,43,53,6,74,3,5]  \n",
    "sorts = bubble(nums)    \n",
    "print(sorts)"
   ]
  },
