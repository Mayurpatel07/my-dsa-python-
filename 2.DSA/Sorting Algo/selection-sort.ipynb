   "source": [
    "def sec(nums):\n",
    "    n = len(nums)\n",
    "    for i in range(n):\n",
    "        min_index = i \n",
    "        for j in range(i+1,n):\n",
    "            if nums[min_index]>nums[j]:\n",
    "                nums[min_index],nums[j] = nums[j],nums[min_index]\n",
    "    return nums\n",
    "\n",
    "\n",
    "\n",
    "nums = [10,5,8,100,2,5,1]\n",
    "print(sec(nums))"
   ]
  }
 ],
