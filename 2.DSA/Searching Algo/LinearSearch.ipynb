   "source": [
    "# LinearSearch \n",
    "\n",
    "\n",
    "def linearsearch(arr,key):\n",
    "    size = len(arr)\n",
    "    for i in range(0,size):\n",
    "        if arr[i]==key:\n",
    "            return i \n",
    "        \n",
    "    return -1 \n",
    "\n",
    "lists =[1,2,3,4,5]\n",
    "key = 3 \n",
    "\n",
    "result = linearsearch(lists,key)\n",
    "print(result)"
   ]
  }
