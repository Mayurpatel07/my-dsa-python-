    "# 33. Search in Rotated Sorted Array\n",
    "nums = [4,5,6,7,0,1,2]\n",
    "target = 1\n",
    "\n",
    "def bs(nums):\n",
    "    mini = min(nums)\n",
    "    mini_indx = nums.index(mini)\n",
    "    n = len(nums)\n",
    "\n",
    "    if target>nums[n-1]:\n",
    "        start = 0 \n",
    "        end = mini_indx-1\n",
    "\n",
    "        while start<=end:\n",
    "            mid = (start+end)//2\n",
    "            if nums[mid]==target:\n",
    "                return mid\n",
    "            elif nums[mid]>target:\n",
    "                end = mid-1 \n",
    "            else :\n",
    "                start = mid+1 \n",
    "        return -1 \n",
    "\n",
    "    elif target<=nums[n-1]:\n",
    "        start = mini_indx\n",
    "        end = n-1 \n",
    "        while start<=end:\n",
    "            mid = (start+end)//2\n",
    "            if nums[mid]==target:\n",
    "                return mid\n",
    "            elif nums[mid]>target:\n",
    "                end = mid-1 \n",
    "            else :\n",
    "                start = mid+1 \n",
    "        return -1 \n",
    "    else :\n",
    "        return -1 \n",
    "    \n",
    "print(bs(nums))\n",
    "  "
   ]
