    "# count negative numebers\n",
    "grid = [\n",
    "  [4,  3,  2, -1],\n",
    "  [3,  2,  1, -1],\n",
    "  [1,  1, -1, -2],\n",
    "  [-1, -1, -2, -3]\n",
    "] \n",
    "\n",
    "n= len(grid)\n",
    "m = len(grid[0])\n",
    "count = 0\n",
    "for i in grid :\n",
    "    m = len(i)\n",
    "    nav = m \n",
    "    start  = 0 \n",
    "    end = m-1 \n",
    "    while start<=end :\n",
    "        mid = (start+end)-start //2 \n",
    "        if i[mid]<0 :\n",
    "            nav = mid \n",
    "            end = mid -1 \n",
    "        else :\n",
    "            start = mid +1 \n",
    "    count = count + (m-nav)\n",
    "print(count)\n",
    "\n"
   ]
