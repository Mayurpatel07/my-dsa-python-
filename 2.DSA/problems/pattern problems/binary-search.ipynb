    "                if nums[mid] == target :\n",
    "                    ans = mid \n",
    "                    end = mid-1 \n",
    "                elif nums[mid] > target :\n",
    "                    end = mid -1 \n",
    "                else :\n",
    "                    start = mid+1 \n",
    "            return ans \n",
    "\n",
