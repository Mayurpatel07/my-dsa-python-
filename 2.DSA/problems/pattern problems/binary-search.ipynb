    "# 33. Search in Rotated Sorted Array\n",
    "def pivot(nums) :   \n",
    "    n = len(nums)\n",
    "    start = 0 \n",
    "    end = n-1\n",
    "    if nums[start]<nums[end] :\n",
    "        return start\n",
    "    while start< end :\n",
    "        mid = (start+end)//2 \n",
    "        if nums[mid]>nums[end] :\n",
    "            start = mid+1 \n",
    "        else :\n",
    "            end = mid\n",
    "    return start\n",
    "\n",
    "\n",
    "def bs1(nums,p):\n",
    "    start = 0 \n",
    "    end = p-1 \n",
    "\n",
    "    while start<=end :\n",
    "        mid = (start+end)//2 \n",
    "        if nums[mid]==target :\n",
    "            return mid \n",
    "        elif nums[mid]>target :\n",
    "            end = mid-1 \n",
    "        else :\n",
    "            start = mid+1 \n",
    "    return -1\n",
    "def bs2(nums,p) :\n",
    "    n = len(nums)\n",
    "    start = p \n",
    "    end = n-1\n",
    "    while start<=end :\n",
    "        mid = (start+end)//2 \n",
    "        if nums[mid]==target :\n",
    "            return mid \n",
    "        elif nums[mid]>target :\n",
    "            end = mid-1 \n",
    "        else :\n",
    "            start = mid+1 \n",
    "    return -1 \n",
    "\n",
    "nums = [1]\n",
    "target = 0\n",
    "n = len(nums)\n",
    "\n",
    "p = pivot(nums)\n",
    "\n",
    "if p == 0:\n",
    "    print(bs2(nums, 0)) \n",
    "\n",
    "elif target >= nums[0] and target <= nums[p-1] :\n",
    "    print(bs1(nums,p))\n",
    "\n",
    "elif target <=nums[n-1] and nums[p]<=target :\n",
    "    print(bs2(nums,p))\n",
    "# search whole array\n",
    "\n",
    "\n",
    "else :\n",
    "    print(-1)\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "  \n",
    "\n",
    "\n"
