    "# Maximum difference between two consecutive elements in a list\n",
    "arr = [2, 5, 1, 8, 3]\n",
    "new_arr = []\n",
    "new = 0 \n",
    "max_diff = 0\n",
    "for i in range(len(arr)-1):\n",
    "    new = abs(arr[i] - arr[i+1])\n",
    "    new_arr.append(new)\n",
    "for i in new_arr :\n",
    "    if i > max_diff :\n",
    "        max_diff = i \n",
    "print(max_diff)"
