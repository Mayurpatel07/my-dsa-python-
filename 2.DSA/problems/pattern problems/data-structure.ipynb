    "# Given a list and an integer k, rotate the list to the right by k steps.\n",
    "arr = [1, 2, 3, 4, 5] \n",
    "arr_rev = []\n",
    "arr_rev1 = []\n",
    "final_arr = []\n",
    "k = 2\n",
    "\n",
    "\n",
    "for i in range(len(arr)-1,-1,-1):  # reversing arr with loop \n",
    "    arr_rev.append(arr[i])\n",
    "\n",
    "for i in range(k):\n",
    "    final_arr.append(arr_rev[i])\n",
    "\n",
    "arr_rev = arr_rev[k:]  # Remove first k elements using slicing\n",
    "\n",
    "for i in range(len(arr_rev)-1,-1,-1):  # reversing arr with loop \n",
    "    arr_rev1.append(arr_rev[i])\n",
    "\n",
    "\n",
    "for i in arr_rev1:\n",
    "    final_arr.append(i)\n",
    "     \n",
    "print(final_arr)   \n",
    "\n"
   ]
