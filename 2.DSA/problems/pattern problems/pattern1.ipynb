    "# Given an integer N, print a square pattern of stars (*) such that:\n",
    "a = 4 \n",
    "i = 0 \n",
    "for i in range(a):\n",
    "    for j in range(a) :\n",
    "        print(\"*\",end=\" \")\n",
    "    print(\"*\")\n"
