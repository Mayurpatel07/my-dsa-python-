    "def bs(nums):\n",
    "    n = len(nums)\n",
    "    for i in range(n):\n",
    "        for j in range(n-1-i):\n",
    "            if nums[j] > nums[j+1]:\n",
    "                nums[j],nums[j+1] = nums[j+1],nums[j]\n",
    "    return nums\n",
    "\n",
    "nums = [5,100,5,2,5,2,5,4,1]\n",
    "result = bs(nums)\n",
    "print(result)\n",
    "\n"
   ]
