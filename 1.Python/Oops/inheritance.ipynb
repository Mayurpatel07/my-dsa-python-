   "source": [
    "# Hierarchical\n",
    "class account:\n",
    "    def __init__(self,balance):\n",
    "        self.balance = balance\n",
    "class saving(account):\n",
    "    def __init__(self,balance):\n",
    "        super().__init__(balance)\n",
    "        print(f\"the balance is {self.balance} in saving Account\")\n",
    "class current(account):\n",
    "    def __init__(self,balance):\n",
    "        super().__init__(balance)\n",
    "        print(f\"the balance is {self.balance} in current Account\")\n",
    "\n",
    "a = current(1000)\n",
    "b = saving(1000)\n",
    "\n",
    "\n"
   ]
  },
