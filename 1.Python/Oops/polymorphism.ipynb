    "# normal Polymorphism \n",
    "class email :\n",
    "    def send(self):\n",
    "        print(\"email sent\")\n",
    "class sms :\n",
    "    def send(self):\n",
    "        print(\"sms sent\")\n",
    "\n",
    "n = sms()\n",
    "n.send()\n",
    "n = email()\n",
    "n.send()\n",
    "# notify = [sms(),email]    # using for loop \n",
    "# for i in notify :\n",
    "#     print(i.send())\n"
