   ],
   "source": [
    "# polymorphism with inheritance \n",
    "class animal :\n",
    "    def sound(self):\n",
    "        print(\"animal sound\")\n",
    "class dog(animal) :\n",
    "    def sound(self):\n",
    "        print(\"dog sound\")\n",
    "class cat(animal) :\n",
    "    def sound(self):\n",
    "        print(\"cat sound\")\n",
    "\n",
    "a = cat()\n",
    "a.sound()\n",
    "a = dog()\n",
    "a.sound()\n",
    "\n"
   ]
  }
