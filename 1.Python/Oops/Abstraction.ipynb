   "source": [
    "# Abstraction \n",
    "# hiding unnecesary deatils from users through classes and method\n",
    "class student :\n",
    "    def __init__(self,first_name,std,percent) :   #creatimg method\n",
    "        self.name = first_name            #Attribute\n",
    "        self.std = std \n",
    "        self.percent=percent\n",
    "    def marks(self):                     #abstraction \n",
    "        print(f\"{self.name} scored {self.percent}% in class {self.std}\")\n",
    "\n",
    "stu = student(\"mayur\",10,88)  #Creating Object \n",
    "\n",
    "stu.marks()\n"
   ]
  }
