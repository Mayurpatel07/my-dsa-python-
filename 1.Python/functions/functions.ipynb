      "name:mayur\n",
      "id:0\n"
     ]
    }
   ],
   "source": [
    "# keyword argument \n",
    "def info(**kwargs):\n",
    "    for key,value in kwargs.items():\n",
    "        print(f\"{key}:{value}\")\n",
    "\n",
    "# calling function \n",
    "info(name = 'mayur',id= 0) # all the arguments are in key value pairs \n"
   ]
  },
