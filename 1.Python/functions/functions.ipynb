      "11\n"
     ]
    }
   ],
   "source": [
    "# creating function \n",
    "def sum(a,b):\n",
    "    sum = a+b\n",
    "    print(sum)\n",
    "\n",
    "#calling function\n",
    "sum(5,6) \n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "14e055bf",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "hello developer\n"
     ]
    }
   ],
   "source": [
    "#default function \n",
    "def hello(name = \"developer\") :  # we give default value in argument \n",
    "    print(f\"hello {name}\")\n",
    "\n",
    "hello()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "67ee0b52",
   "metadata": {},
   "outputs": [],
   "source": [
    "# positional argument \n",
    "def sum(a,b):\n",
    "    sum = a+b\n",
    "    print(sum)\n",
    "\n",
    "#calling function\n",
    "sum(5,6)  # we are giving 5 as (a) 6 as (b) this are positions "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "0aac56b5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1\n",
      "2\n",
      "3\n",
      "3\n",
      "4\n",
      "5\n",
      "6\n"
     ]
    }
   ],
   "source": [
    "# variable length function \n",
    "def nums(*args): # by adding * we can give multiple arguemtns \n",
    "    for nums in args:\n",
    "        print(nums)\n",
    "\n",
    "nums(1,2,3,3,4,5,6) \n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "3120f7ae",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
