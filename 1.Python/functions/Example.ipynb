    "# check that a string is palindrome\n",
    "def string(s): \n",
    "    s = s.lower()\n",
    "    s = s.replace(\" \",\"\")\n",
    "    print(s)\n",
    "    if s == s[::-1] :\n",
    "        return(\"it is palindrome\")\n",
    "    else :\n",
    "        return(\"its not palindrome\")\n",
    "    \n",
    "string(\"A man a plan a canal Panama\")\n",
    "    "
