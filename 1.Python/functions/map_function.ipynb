   "source": [
    "map()\n",
    "The map() function applies a given function to all items in an input list (or any other iterable) and returns a map\n",
    "object (an iterator). This is particularly useful for transforming data in a list comprehensively."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "8dad4ee8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# syntax \n",
    "# map(function,ittrable)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "64d8ae0f",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "[1, 4, 9, 16, 25, 36, 49, 64]"
      ]
     },
     "execution_count": 7,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# using map in normal function \n",
    "def sq(x):\n",
    "    x = x**2\n",
    "    return x \n",
    "\n",
    "nums = [1,2,3,4,5,6,7,8]\n",
    "\n",
    "list(map(sq,nums))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "1df2f763",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "[1, 4, 9, 16, 25, 36]"
      ]
     },
     "execution_count": 6,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# using map in lambda function \n",
    "nums1 = [1,2,3,4,5,6]\n",
    "list(map(lambda x :x**2 , nums1))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "9d1714d3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[12, 24, 36, 48, 60]\n"
     ]
    }
   ],
   "source": [
    "# using map in multiple ittrate \n",
    "\n",
    "# que: adding each elemts with each element  like 1+11 , 2+22 etc\n",
    "\n",
    "numbers1 = [1,2,3,4,5]\n",
    "numbers2 = [11,22,33,44,55]\n",
    "\n",
    "added_num = list(map(lambda a,b: a+b ,numbers1,numbers2))\n",
    "print(added_num)\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
