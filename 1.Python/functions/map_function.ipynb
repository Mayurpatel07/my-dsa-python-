   "source": [
    "# using map for inbuild functions \n",
    "\n",
    "# que convert all list string into int \n",
    "\n",
    "list1 = [\"1\",'2','3','4']\n",
    "\n",
    "int_list = list(map(int,list1))\n",
    "print(int_list)"
