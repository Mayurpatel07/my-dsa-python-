    "##Calculater \n",
    "\n",
    "num1= int(input(\"enter num1\"))\n",
    "num2= int(input(\"enter num2\"))\n",
    "\n",
    "operator = str(input(\"select which type of operation you want to perform (Add,sub,mult,divide\"))\n",
    "\n",
    "if(operator == \"+\" ):\n",
    "    print(num1 + num2)\n",
    "elif(operator == \"-\"):\n",
    "    print(num1 - num2)\n",
    "elif(operator == \"*\"):\n",
    "    print(num1 * num2)\n",
    "elif(operator == \"/\"):\n",
    "    print(num1 / num2)\n",
    "else:\n",
    "    print(\"wrong operation choosed retry again !! \")\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n"
   ]
