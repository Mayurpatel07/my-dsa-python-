    "##nested if-else statement \n",
    "\n",
    "#check num is even or odd exmaple \n",
    "\n",
    "num = int(input(\"enter the number\"))\n",
    "if num > 0 :\n",
    "    if num%2==0 :\n",
    "        print(num, \"is even\")\n",
    "    else :\n",
    "        print(num,\"num is odd\") \n",
    "elif num == 0 :\n",
    "    print(\"nmuber is zero so re-enter it...\")\n",
    "else :\n",
    "    print(num,\"is negative or zero so re-enter it...\")\n"
   ]
  }
