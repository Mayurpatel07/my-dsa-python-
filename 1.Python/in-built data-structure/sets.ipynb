   "source": [
    "# mathamatical operations \n",
    "set1 = {1,2,3,4,5}\n",
    "set2 = {1,3,4,24,5,6,7,8}\n",
    "\n",
    "# union (mix both sets)\n",
    "print(set1.union(set2))\n",
    "\n",
    "# intersection (give you common element)\n",
    "print(set1.intersection(set2))\n",
    "# intersection with update (will update set)\n",
    "set1.intersection_update(set2)\n",
    "print(set1)\n",
    "\n",
    "\n",
    "\n"
   ]
