    "\n",
    "set1 = {1,2,3,4,5}\n",
    "set2 = {1,3,4,24,5,6,7,8}\n",
    "# diffrence (element that are not present in another set )\n",
    "print(set1.difference(set2))\n",
    "\n",
    "# symmetric differenence (all common elements will get removed )\n",
    "print(set1.symmetric_difference(set2))\n",
