      "(1, 2, 3, 4)\n",
      "3\n",
      "(1, 2, 3)\n"
     ]
    }
   ],
   "source": [
    "# nested tuples \n",
    "n_tup = ((1,2,3,4),(1,2,5,5),(2,3,4,5,5))\n",
    "print(n_tup)\n",
    "print(n_tup[0])\n",
    "print(n_tup[0][2])\n",
    "print(n_tup[0][0:3])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "44a3904c",
   "metadata": {},
