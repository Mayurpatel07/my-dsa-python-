      "3\n",
      "7\n"
     ]
    }
   ],
   "source": [
    "# tuple methods \n",
    "tup3 = (1,1,2,3,4,4,4,5,6)\n",
    "print(tup3.count(1)) #howmany time no. is repating \n",
    "print(tup3.count(4))\n",
    "print(tup3.index(5)) #giving index no. of elemt\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "667b1259",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "(2, 3, 4, 'mayur')\n",
      "2\n",
      "3\n",
      "mayur\n",
      "2\n",
      "[3, 4]\n",
      "mayur\n"
     ]
    }
   ],
   "source": [
    "# packing and up packing \n",
    "## packing \n",
    "pack_tup = 2,3,4,\"mayur\"\n",
    "print(pack_tup) #automatic convet to tuple \n",
    "\n",
    "##unpacking tuple \n",
    "# method 1 \n",
    "a,b,c,d = pack_tup\n",
    "print(a)\n",
    "print(b)\n",
    "print(d)\n",
    "# method 2 \n",
    "first,*mid,last = pack_tup\n",
    "print(first)\n",
    "print(mid)\n",
    "print(last)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "07d2ed21",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
