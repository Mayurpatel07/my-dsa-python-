   "source": [
    "# tail resursion (first print that call) (it's best , it do not do call back, it is fast )\n",
    "# print n to 1 \n",
    "\n",
    "def print1(n):\n",
    "    if n ==0 :\n",
    "        return \n",
    "    else :\n",
    "        print(n)\n",
    "        print1(n-1)\n",
    "\n",
    "print1(5)\n"
   ]
  }
