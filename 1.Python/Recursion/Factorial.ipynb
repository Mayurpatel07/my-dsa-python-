   "source": [
    "# head Recursion  (first call that print)\n",
    "# print 1 to n \n",
    "def printn(n):\n",
    "    if n == 0 :\n",
    "        return \n",
    "    else :\n",
    "        printn(n-1)\n",
    "        print(n)\n",
    "    \n",
    "    \n",
    "printn(5)\n"
   ]
  },
