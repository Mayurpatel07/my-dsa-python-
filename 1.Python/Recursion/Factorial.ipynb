    "def fec(n):\n",
    "    if n == 0  :\n",
    "        return 0\n",
    "    if n == 1 :\n",
    "        return 1 \n",
    "    else :\n",
    "        return fec(n-1)+fec(n-2)\n",
    "    \n",
    "fec(6)"
   ]
  },
