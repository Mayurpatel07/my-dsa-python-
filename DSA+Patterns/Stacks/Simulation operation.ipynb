    "# 1544. Make The String Great\n",
    "s = \"leEeetcode\"\n",
    "stack =[]\n",
    "for ch in s:\n",
    "    if stack and stack[-1].lower() == ch.lower() and stack[-1] != ch:\n",
    "        stack.pop()\n",
    "    else:\n",
    "        stack.append(ch)\n",
    "print(''.join(stack)) \n",
    "    "
