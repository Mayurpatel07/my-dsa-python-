    "# 1047. Remove All Adjacent Duplicates In String\n",
    "s = \"abbaca\"\n",
    "stack =[]\n",
    "for i in s :\n",
    "    if stack and stack[-1]==i:\n",
    "        stack.pop()\n",
    "    else :\n",
    "        stack.append(i)\n",
    "    \n",
    "print(\"\".join(stack))\n",
    "\n",
    "\n"
   ]
