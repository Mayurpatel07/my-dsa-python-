    "# 2696. Minimum String Length After Removing Substrings\n",
    "s = \"ACBBD\"\n",
    "stack = []\n",
    "for i in s :\n",
    "    if stack and stack[-1] == \"A\" and i == \"B\":\n",
    "        stack.pop()\n",
    "    elif stack and stack[-1] == \"C\" and i == \"D\":\n",
    "        stack.pop()\n",
    "    else :\n",
    "        stack.append(i)\n",
    "\n",
    "\n",
    "print(len(stack))\n",
    "\n",
    "\n"
