    "# 844. Backspace String Compare\n",
    "t = \"a##c\"\n",
    "s = \"#a#c\"\n",
    "stack1 = []\n",
    "stack2 = []\n",
    "for i in t:\n",
    "    if i != \"#\":\n",
    "        stack1.append(i)\n",
    "    else :\n",
    "        if stack1:\n",
    "            stack1.pop()\n",
    "for i in s:\n",
    "    if i != \"#\":\n",
    "        stack2.append(i)\n",
    "    else :\n",
    "        if stack2 :\n",
    "            stack2.pop()\n",
    "\n",
    "if stack1 == stack2 :\n",
    "    print(\"true\")\n",
    "else :\n",
    "    print(\"false\")\n",
    "\n",
    "    "
   ]
