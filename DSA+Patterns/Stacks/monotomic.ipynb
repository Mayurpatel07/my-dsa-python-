    "# 496. Next Greater Element I\n",
    "nums1 = [4,1,2]\n",
    "nums2 = [1,3,4,2]\n",
    "stack = []\n",
    "dis={}\n",
    "\n",
    "for i in nums2:\n",
    "    while stack and stack[-1]<i:\n",
    "       popped = stack.pop()\n",
    "       dis[popped] = i \n",
    "\n",
    "    stack.append(i)\n",
    "\n",
    "while stack :\n",
    "    dis[stack.pop()] = -1 \n",
    "\n",
    "ans = [] \n",
    "for i in nums1:\n",
    "   \n",
    "    ans.append(dis[i])\n",
    "print(ans)\n"
   ]
