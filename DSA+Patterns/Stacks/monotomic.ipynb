    "# 503. Next Greater Element II\n",
    "nums = [1,2,3,4,3]\n",
    "stack = []\n",
    "n = len(nums)\n",
    "ans =[-1]*n\n",
    "for i in range(n*2):\n",
    "    curr = i%n\n",
    "    while stack and nums[stack[-1]]<nums[curr]:\n",
    "         popped = stack.pop()\n",
    "         ans[popped]=nums[curr]\n",
    "    stack.append(curr)\n",
    "print(ans)"
   ]
