    "# 227. Basic Calculator II\n",
    "s = \"3+5 / 2\"\n",
    "num = []\n",
    "op=[]\n",
    "def operate(a, b, operator):\n",
    "    if operator == \"+\":\n",
    "        return a + b\n",
    "    elif operator == \"-\":\n",
    "        return a - b\n",
    "    elif operator == \"*\":\n",
    "        return a * b\n",
    "    elif operator == \"/\":\n",
    "        return int(a/b)\n",
    "def seq(n):     \n",
    "    if n == '-':\n",
    "         return 1 \n",
    "    elif n == '+':\n",
    "         return 1\n",
    "    elif n == '*':\n",
    "         return 2\n",
    "    elif n == '/':\n",
    "         return 2\n",
    "    elif n == \"^\" :\n",
    "         return 3 \n",
    "    return 0 \n",
    "\n",
    "for i in s :\n",
    "    if i == ' ':\n",
    "        continue\n",
    "    if i not in \"+-/*^\":\n",
    "          num.append(int(i))\n",
    "    else :\n",
    "        \n",
    "        while op and seq(op[-1])>=seq(i):\n",
    "            popped = op.pop()\n",
    "            right = int(num.pop())\n",
    "            left = int(num.pop())\n",
    "            new = operate(left,right,popped)\n",
    "            num.append(new)\n",
    "        op.append(i)    \n",
    "while op:  \n",
    "    right = int(num.pop())\n",
    "    left = int(num.pop())\n",
    "    c = op.pop()\n",
    "    new = operate(left,right,c)\n",
    "    num.append(new)\n",
    "print(num[-1])\n",
    "\n",
    "              \n",
    "              \n",
    "              \n",
    "     \n"
   ]
