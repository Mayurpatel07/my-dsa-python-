    "s = \"3+5 / 2\"\n",
    "num = []\n",
    "op=[]\n",
    "def operate(a, b, operator):\n",
    "    if operator == \"+\":\n",
    "        return a + b\n",
    "    elif operator == \"-\":\n",
    "        return a - b\n",
    "    elif operator == \"*\":\n",
    "        return a * b\n",
    "    elif operator == \"/\":\n",
    "        return int(a/b)\n",
    "def seq(n):     \n",
    "    if n == '-':\n",
    "         return 1 \n",
    "    elif n == '+':\n",
    "         return 1\n",
    "    elif n == '*':\n",
    "         return 2\n",
    "    elif n == '/':\n",
    "         return 2\n",
    "    elif n == \"^\" :\n",
    "         return 3 \n",
    "    return 0 \n",
    "\n",
    "for i in s :\n",
    "    if i == ' ':\n",
    "        continue\n",
    "    if i not in \"+-/*^\":\n",
    "          num.append(int(i))\n",
    "    elif i ==\"(\":\n",
    "        op.append(i)\n",
    "    elif i ==')':\n",
    "        while num[-1] != '(':\n",
    "            popped = op.pop()\n",
    "            right = int(num.pop())\n",
    "            left = int(num.pop())\n",
    "            num.append(operate(left,right,popped))\n",
    "            \n",
    "    else :\n",
    "        while op and op[-1]!=\"(\" and seq(op[-1])>=seq(i):\n",
    "            popped = op.pop()\n",
    "            right = int(num.pop())\n",
    "            left = int(num.pop())\n",
    "            new = operate(left,right,popped)\n",
    "            num.append(new)\n",
    "        op.append(i)\n",
    "while op:  \n",
    "    right = int(num.pop())\n",
    "    left = int(num.pop())\n",
    "    c = op.pop()\n",
    "    new = operate(left,right,c)\n",
    "    num.append(new)\n",
    "print(num[-1])\n"
