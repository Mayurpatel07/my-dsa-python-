    "# 150. Evaluate Reverse Polish Notation\n",
    "token = [\"2\",\"1\",\"+\",\"3\",\"*\"]\n",
    "stack = []\n",
    "for i in token:\n",
    "    if i not in \"+-/*\" :\n",
    "        stack.append(i)\n",
    "    else :\n",
    "        right = int(stack.pop())\n",
    "        left = int(stack.pop())\n",
    "        if i == '+':\n",
    "            ans = left+right\n",
    "        elif i == '*':\n",
    "            ans = left*right\n",
    "        elif i == '/':\n",
    "            ans = int(left/right)\n",
    "        else :\n",
    "            ans = left-right \n",
    "        stack.append(ans)\n",
    "print(stack[-1])\n",
    "\n",
    "\n",
    "\n",
    "        \n",
    "\n",
    "\n",
    "    \n",
    "\n"
   ]
