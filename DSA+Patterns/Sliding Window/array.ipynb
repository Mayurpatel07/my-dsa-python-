    "# Maximum Average Subarray I # Leetcode 643.\n",
    "nums = [1,12,5,6,50,3]\n",
    "k = 4\n",
    "left = 0 \n",
    "win_s = 0 \n",
    "avg = 0 \n",
    "max_new = 0 \n",
    "\n",
    "for right in range(len(nums)):\n",
    "    win_s = win_s + nums[right]\n",
    "    if right-left+1 == k :\n",
    "        avg = (win_s/k)\n",
    "        max_new = max(max_new,avg)\n",
    "        win_s = win_s - nums[left]\n",
    "        left = left +1\n",
