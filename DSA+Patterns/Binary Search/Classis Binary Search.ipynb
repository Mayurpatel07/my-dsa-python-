    "# 69. Sqrt(x)   \n",
    "x = 8\n",
    "left = 0 \n",
    "right = x\n",
    "ans = 0 \n",
    "\n",
    "while left <=right:\n",
    "    mid = left+(right-left)//2\n",
    "    sq = mid*mid\n",
    "    if sq==x:\n",
    "        ans = mid \n",
    "        break \n",
    "    elif sq>x :\n",
    "        right = mid-1 \n",
    "    else :\n",
    "        ans = mid    \n",
    "        left = mid+1\n",
    "print(ans)"
