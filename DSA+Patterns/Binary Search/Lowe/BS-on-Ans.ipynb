    "import math \n",
    "piles = [3,6,7,11]\n",
    "h = 8\n",
    "\n",
    "def check(mid):\n",
    "    hours = 0 \n",
    "    for i in piles:\n",
    "        hours += math.ceil(i/mid)\n",
    "    return hours<=h \n",
    "\n",
    "# check()\n",
    "\n",
    "left = 1\n",
    "right = max(piles)\n",
    "while left<=right :\n",
    "    mid = left+(right-left)//2 \n",
    "    if check(mid) :\n",
    "        ans = mid \n",
    "        right = mid -1 \n",
    "    else :\n",
    "        left = mid +1 \n",
    "print(ans)  \n",
    "\n",
    "    "
