    "        tt  += math.ceil(dist[i]/mid)\n",
    "    i = len(dist)-1 \n",
    "    tt = tt+ dist[i]/mid\n",
    "    if tt<=hour :\n",
    "        return True \n",
    "    else :\n",
    "        return False    \n",
    "    \n",
    "left = 1 \n",
    "right = 10**5 \n",
    "time = -1 \n",
