   "source": [
    "# Pair Sum \n",
    "arr = [1, 2, 3, 4, 6]\n",
    "target = 6\n",
    "l = 0 \n",
    "r = len(arr)-1 \n",
    "while l < r :\n",
    "    sum = arr[l] + arr[r]\n",
    "    if sum == target :\n",
    "         print(l,r)\n",
    "         break\n",
    "    elif sum>target :\n",
    "         r = r-1 \n",
    "    else :\n",
    "         l = l +1 \n"
   ]
