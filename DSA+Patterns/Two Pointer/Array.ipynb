    "# remove duplicate \n",
    "arr = [1,2,2,3,3,4]\n",
    "slow = 0 \n",
    "\n",
    "\n",
    "for fast in range(len(arr)):\n",
    "    if arr[fast] != arr[slow]:\n",
    "        slow = slow +1 \n",
    "        arr[slow] = arr[fast]\n",
    "\n",
    "print(arr[:slow+1])\n"
   ]
