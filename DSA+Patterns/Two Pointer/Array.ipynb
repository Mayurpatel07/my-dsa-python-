   "source": [
    "# Reverse Array\n",
    "arr = [1,2,3,4,5]\n",
    "L = 0 \n",
    "R = len(arr)-1\n",
    "while L<R :\n",
    "    arr[L],arr[R] = arr[R],arr[L]\n",
    "    L = L+1 \n",
    "    R = R-1\n",
    "\n",
    "print(arr)\n",
    "\n"
   ]
