    "# is parandrome #leetcode 125\n",
    "s = \"APLPA\"\n",
    "\n",
    "new = \"\"\n",
    "for ch in s :\n",
    "    if ch.isalnum() :\n",
    "        new = new + ch.lower()\n",
    "new = new.replace(\" \",\"\")\n",
    "\n",
    "l = 0 \n",
    "r = len(new)-1\n",
    "result = True\n",
    "while l <= r :\n",
    "    if new[l] != new[r]:\n",
    "        result = False\n",
    "    r=r-1\n",
    "    l = l+1\n",
    "print(result)\n",
    "print(new)\n",
    "\n"
   ]
